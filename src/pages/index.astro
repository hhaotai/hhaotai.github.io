---
/**
 * Haotai Huang · personal academic homepage
 * Update profile, education, interests, and notes below.
 * Set profile.avatar to a file in public/ when you have a photo to use.
 * Interests describe questions, not completed projects. Empty notes stay hidden.
 */
type Link = { label: string; href: string };
type Interest = { title: string; description: string };
type Note = { title: string; date: string; href: string; category?: string };

const profile = {
  name: "Haotai Huang",
  initials: "HH",
  email: "51295902036@stu.ecnu.edu.cn",
  github: "https://github.com/hhaotai",
  cv: "", // Add public/cv.pdf, then set this to "cv.pdf".
  scholar: "",
  avatar: "", // Add public/avatar.jpg, then set this to "avatar.jpg".
  avatarPosition: "50% 50%",
  role: "Software Engineering",
  affiliation: "East China Normal University",
  lead: "I’m interested in how AI agents learn from experience—and what makes them reliable.",
  bio: "I’m studying Software Engineering at East China Normal University. I want to understand how agents learn from past interactions, recognize their mistakes, and adapt to unfamiliar tasks.",
};

const education = [
  { institution: "East China Normal University", detail: "Software Engineering", period: "2026 — Present" },
  { institution: "Huaqiao University", detail: "Computer Science and Technology", period: "2022 — 2026" },
];

const interests: Interest[] = [
  {
    title: "Agent learning & memory",
    description: "What should an agent remember? I’m curious about how it can reuse experience, correct mistakes, and know when to forget.",
  },
  {
    title: "Evaluation & generalization",
    description: "How can we tell if an agent has improved? I’m interested in what carries over to unfamiliar tasks, and where apparent gains break down.",
  },
  {
    title: "Reliable agent systems",
    description: "What makes an agent dependable? I’m interested in clear requirements, traceable decisions, and practical ways to detect failures.",
  },
];
const notes: Note[] = [];

const base = import.meta.env.BASE_URL;
function asset(path: string): string {
  const clean = path.trim();
  if (!clean) return "";
  if (/^(https?:\/\/|mailto:|tel:|#)/i.test(clean)) return clean;
  if (/^[a-z][a-z\d+.-]*:/i.test(clean) || clean.startsWith("//")) return "";
  return `${base.replace(/\/$/, "")}/${clean.replace(/^\/+/, "")}`;
}
const isExternal = (href: string) => /^https?:\/\//i.test(href);
const profileLinks: Link[] = [
  ...(profile.github ? [{ label: "GitHub", href: profile.github }] : []),
  ...(profile.cv ? [{ label: "CV", href: profile.cv }] : []),
  ...(profile.scholar ? [{ label: "Scholar", href: profile.scholar }] : []),
].filter((link) => asset(link.href));
const nav = [
  { label: "About", href: "#about" },
  ...(interests.length ? [{ label: "Interests", href: "#interests" }] : []),
  ...(education.length ? [{ label: "Education", href: "#education" }] : []),
  ...(notes.length ? [{ label: "Notes", href: "#notes" }] : []),
];
const year = new Date().getFullYear();
const description = "Haotai Huang · Software Engineering at East China Normal University. Interests in agent learning, memory, and reliable AI systems.";
const canonical = new URL(base, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" id="theme-color" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.name} · Personal homepage`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <title>{profile.name} · Personal homepage</title>
    <script is:inline>
      (() => {
        let theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        try {
          const saved = localStorage.getItem("haotai-theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch (_) {}
        document.documentElement.dataset.theme = theme;
        document.getElementById("theme-color")?.setAttribute("content", theme === "dark" ? "#10151f" : "#ffffff");
      })();
    </script>
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label={`${profile.name}, home`}>{profile.initials}<span aria-hidden="true">.</span></a>
        <div class="header-actions">
          <nav aria-label="Main navigation">
            {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" hidden>
            <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.8 13.2A8.5 8.5 0 0 1 10.8 3a8.5 8.5 0 1 0 10 10.2Z" />
            </svg>
            <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="container" id="main">
      <section class:list={["hero", { "has-portrait": !!profile.avatar }]} id="about" aria-labelledby="name">
        <div class="hero-copy">
          <p class="eyebrow">{profile.role}</p>
          <h1 id="name">{profile.name}</h1>
          <p class="affiliation">{profile.affiliation}</p>
          <p class="lead">{profile.lead}</p>
          <p class="bio">{profile.bio}</p>
          <div class="contact-links" aria-label="Contact and profiles">
            {profile.email && (
              <div class="email-group">
                <a id="email-link" href={`mailto:${profile.email}`}>{profile.email}</a>
                <button class="copy-email" id="copy-email" type="button" data-email={profile.email} aria-label="Copy email address" title="Copy email address" hidden>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V4H4v12h4" />
                  </svg>
                </button>
              </div>
            )}
            {profileLinks.map((link) => (
              <a href={asset(link.href)} target={isExternal(link.href) ? "_blank" : undefined} rel={isExternal(link.href) ? "noopener noreferrer" : undefined}>
                {link.label}<span class="external-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
        {profile.avatar && asset(profile.avatar) && (
          <figure class="portrait" id="portrait">
            <img id="portrait-image" src={asset(profile.avatar)} alt={`Portrait of ${profile.name}`} width="192" height="224" decoding="async" style={`object-position:${profile.avatarPosition}`} />
          </figure>
        )}
      </section>

      {interests.length > 0 && (
        <section class="content-section" id="interests" aria-labelledby="interests-heading">
          <header class="section-header">
            <h2 id="interests-heading">Research interests</h2>
            <p>Questions I’m interested in exploring.</p>
          </header>
          <div class="interest-list">
            {interests.map((interest) => (
              <article class="interest">
                <h3>{interest.title}</h3>
                <p>{interest.description}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {education.length > 0 && (
        <section class="content-section" id="education" aria-labelledby="education-heading">
          <header class="section-header"><h2 id="education-heading">Education</h2></header>
          <div class="education-list">
            {education.map((item) => (
              <article class="education-item">
                <div><h3>{item.institution}</h3><p>{item.detail}</p></div>
                <span class="period">{item.period}</span>
              </article>
            ))}
          </div>
        </section>
      )}

      {notes.length > 0 && (
        <section class="content-section" id="notes" aria-labelledby="notes-heading">
          <header class="section-header"><h2 id="notes-heading">Notes</h2></header>
          <div class="notes-list">
            {notes.filter((note) => asset(note.href)).map((note) => (
              <a class="note" href={asset(note.href)} target={isExternal(note.href) ? "_blank" : undefined} rel={isExternal(note.href) ? "noopener noreferrer" : undefined}>
                <time datetime={note.date}>{note.date.slice(0, 7).replace("-", ".")}</time>
                <div><h3>{note.title}</h3>{note.category && <p>{note.category}</p>}</div>
                <span class="external-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer class="container site-footer">
      <p>© {year} {profile.name}</p>
      {profile.email && <a href={`mailto:${profile.email}`}>Get in touch<span class="external-arrow" aria-hidden="true">↗</span></a>}
    </footer>
    <p class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></p>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.getElementById("theme-toggle");
        const themeColor = document.getElementById("theme-color");
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        function savedTheme() {
          try {
            const saved = localStorage.getItem("haotai-theme");
            return saved === "light" || saved === "dark" ? saved : null;
          } catch (_) { return null; }
        }
        function setTheme(theme, persist = false) {
          const dark = theme === "dark";
          root.dataset.theme = dark ? "dark" : "light";
          const action = dark ? "Switch to light theme" : "Switch to dark theme";
          toggle?.setAttribute("aria-label", action);
          toggle?.setAttribute("title", action);
          themeColor?.setAttribute("content", dark ? "#10151f" : "#ffffff");
          if (persist) {
            try { localStorage.setItem("haotai-theme", root.dataset.theme); } catch (_) {}
          }
        }
        if (toggle) {
          setTheme(root.dataset.theme);
          toggle.hidden = false;
          toggle.addEventListener("click", () => setTheme(root.dataset.theme === "dark" ? "light" : "dark", true));
        }
        systemTheme.addEventListener("change", () => {
          if (!savedTheme()) setTheme(systemTheme.matches ? "dark" : "light");
        });
        window.addEventListener("storage", (event) => {
          if (event.key === "haotai-theme" || event.key === null) {
            setTheme(savedTheme() || (systemTheme.matches ? "dark" : "light"));
          }
        });

        const toast = document.getElementById("toast");
        let toastTimer;
        function announce(message) {
          if (!toast) return;
          clearTimeout(toastTimer);
          toast.textContent = message;
          toast.classList.add("show");
          toastTimer = setTimeout(() => toast.classList.remove("show"), 2400);
        }
        const copyButton = document.getElementById("copy-email");
        if (copyButton) {
          copyButton.hidden = false;
          copyButton.addEventListener("click", async () => {
            const email = copyButton.dataset.email;
            if (!email) return;
            try {
              if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
              await navigator.clipboard.writeText(email);
              announce("Email copied.");
            } catch (_) {
              const emailLink = document.getElementById("email-link");
              if (emailLink) {
                const range = document.createRange();
                range.selectNodeContents(emailLink);
                const selection = window.getSelection();
                selection?.removeAllRanges();
                selection?.addRange(range);
              }
              announce("Email selected — copy it manually.");
            }
          });
        }
        const portrait = document.getElementById("portrait-image");
        if (portrait instanceof HTMLImageElement) {
          const fail = () => {
            document.getElementById("portrait")?.setAttribute("hidden", "");
            document.getElementById("about")?.classList.remove("has-portrait");
          };
          portrait.addEventListener("error", fail, { once: true });
          if (portrait.complete && !portrait.naturalWidth) fail();
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --background: #ffffff;
    --foreground: #172031;
    --body: #4c5769;
    --muted: #697386;
    --accent: #315fbd;
    --accent-soft: #edf3ff;
    --line: #e6eaf0;
    --surface: #f7f9fc;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  }
  html[data-theme="dark"] {
    color-scheme: dark;
    --background: #10151f;
    --foreground: #ecf0f7;
    --body: #b0bbcc;
    --muted: #939fb3;
    --accent: #92b8ff;
    --accent-soft: #1b2a44;
    --line: #29313f;
    --surface: #18202d;
  }
  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; scroll-padding-top: 32px; }
  body { margin: 0; background: var(--background); color: var(--foreground); font: 16px/1.75 var(--sans); -webkit-font-smoothing: antialiased; }
  h1, h2, h3, p, figure { margin: 0; }
  img { display: block; max-width: 100%; }
  a { color: inherit; text-decoration: none; text-underline-offset: 5px; }
  button { font: inherit; color: inherit; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 3px; }
  ::selection { color: var(--foreground); background: var(--accent-soft); }
  .container { width: min(960px, calc(100% - 80px)); margin-inline: auto; }
  .skip-link { position: fixed; left: 16px; top: -100px; z-index: 20; padding: 10px 16px; color: var(--background); background: var(--foreground); border-radius: 6px; }
  .skip-link:focus { top: 12px; }

  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner { min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { min-height: 44px; display: inline-flex; align-items: center; font-size: 21px; font-weight: 700; letter-spacing: -1px; }
  .brand span { color: var(--accent); }
  .header-actions { display: flex; align-items: center; gap: 24px; min-width: 0; }
  nav { display: flex; align-items: center; gap: 27px; flex-wrap: wrap; justify-content: flex-end; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; }
  nav a:hover { color: var(--accent); }
  .theme-toggle { flex: 0 0 44px; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; color: var(--body); background: transparent; cursor: pointer; }
  .theme-toggle:hover { color: var(--accent); background: var(--accent-soft); }
  .sun-icon { display: none; }
  html[data-theme="dark"] .moon-icon { display: none; }
  html[data-theme="dark"] .sun-icon { display: block; }

  .hero { padding: 80px 0 64px; }
  .hero.has-portrait { display: grid; grid-template-columns: minmax(0, 1fr) 192px; align-items: start; gap: 48px; }
  .eyebrow { margin-bottom: 13px; color: var(--accent); font-size: 13px; font-weight: 600; letter-spacing: .02em; }
  h1 { font-size: clamp(42px, 6vw, 68px); line-height: 1.12; font-weight: 650; letter-spacing: -.055em; }
  .affiliation { margin-top: 15px; color: var(--muted); font-size: 17px; }
  .lead { max-width: 760px; margin-top: 37px; color: var(--foreground); font-size: 25px; font-weight: 400; line-height: 1.6; letter-spacing: -.025em; text-wrap: pretty; }
  .bio { max-width: 730px; margin-top: 19px; color: var(--body); font-size: 16px; line-height: 1.9; text-wrap: pretty; }
  .contact-links { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 26px; margin-top: 25px; }
  .contact-links a { display: inline-flex; align-items: center; min-height: 44px; gap: 5px; color: var(--accent); font-size: 13px; }
  .contact-links a:hover, .site-footer a:hover { text-decoration: underline; }
  .email-group { display: flex; align-items: center; min-width: 0; }
  .email-group a { overflow-wrap: anywhere; }
  .copy-email { display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; margin-left: 2px; padding: 0; color: var(--muted); background: transparent; border: 0; border-radius: 6px; cursor: pointer; }
  .copy-email:hover { color: var(--accent); background: var(--accent-soft); }
  .external-arrow { display: inline-block; margin-left: 5px; font-size: .95em; }
  .portrait { margin-top: 4px; overflow: hidden; border-radius: 12px; background: var(--surface); }
  .portrait img { width: 192px; height: 224px; object-fit: cover; }

  .content-section { padding: 44px 0 46px; border-top: 1px solid var(--line); }
  .section-header { margin-bottom: 10px; }
  h2 { font-size: 25px; line-height: 1.4; font-weight: 600; letter-spacing: -.035em; }
  .section-header > p { margin-top: 8px; color: var(--muted); font-size: 14px; }
  .interest { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 44px; align-items: baseline; padding: 24px 0; }
  .interest + .interest { border-top: 1px solid var(--line); }
  .interest h3 { color: var(--foreground); font-size: 16px; line-height: 1.65; font-weight: 550; letter-spacing: -.02em; }
  .interest p { max-width: 62ch; color: var(--body); font-size: 15px; line-height: 1.9; text-wrap: pretty; }
  .education-item { display: flex; align-items: baseline; justify-content: space-between; gap: 16px 28px; padding: 23px 0; }
  .education-item + .education-item { border-top: 1px solid var(--line); }
  .education-item h3 { font-size: 16px; font-weight: 550; letter-spacing: -.015em; }
  .education-item p { margin-top: 4px; color: var(--body); font-size: 14px; }
  .period { color: var(--muted); font-size: 13px; white-space: nowrap; }
  .note { display: grid; grid-template-columns: 70px minmax(0, 1fr) 16px; align-items: baseline; gap: 24px; padding: 22px 0; }
  .note + .note { border-top: 1px solid var(--line); }
  .note time { color: var(--muted); font-size: 12px; }
  .note h3 { font-size: 16px; font-weight: 550; }
  .note p { margin-top: 4px; color: var(--muted); font-size: 13px; }
  .note:hover h3 { color: var(--accent); }

  .site-footer { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 27px 0 40px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
  .site-footer a { display: inline-flex; align-items: center; min-height: 44px; }
  .toast { position: fixed; left: 50%; bottom: 24px; z-index: 20; max-width: calc(100% - 32px); padding: 10px 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--foreground); font-size: 13px; opacity: 0; pointer-events: none; transform: translate(-50%, 8px); transition: opacity 160ms ease, transform 160ms ease; }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  @media (max-width: 760px) {
    .container { width: calc(100% - 48px); }
    .header-inner { min-height: 76px; }
    .header-actions { gap: 14px; }
    nav { gap: 20px; }
    .hero { padding: 56px 0 48px; }
    .hero.has-portrait { grid-template-columns: minmax(0, 1fr) 136px; gap: 28px; }
    .portrait img { width: 136px; height: 160px; }
    .lead { font-size: 23px; }
    .interest { grid-template-columns: 205px minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 560px) {
    .container { width: calc(100% - 40px); }
    .header-inner { min-height: 72px; gap: 12px; }
    .header-actions { gap: 8px; }
    nav { gap: 13px; }
    nav a { font-size: 12px; }
    .brand { font-size: 19px; }
    .hero, .hero.has-portrait { display: block; padding: 44px 0 39px; }
    h1 { font-size: clamp(38px, 10vw, 48px); }
    .affiliation { margin-top: 13px; font-size: 15px; }
    .lead { margin-top: 28px; font-size: 22px; line-height: 1.6; }
    .bio { font-size: 15px; margin-top: 16px; }
    .contact-links { gap: 2px 20px; margin-top: 20px; }
    .contact-links a { font-size: 12px; }
    .portrait { width: 136px; margin-top: 26px; }
    .content-section { padding: 32px 0 30px; }
    h2 { font-size: 23px; }
    .interest { display: block; padding: 23px 0; }
    .interest h3 { font-size: 16px; }
    .interest p { margin-top: 9px; font-size: 14px; }
    .education-item { display: block; padding: 21px 0; }
    .education-item h3 { font-size: 15px; }
    .period { display: block; margin-top: 8px; font-size: 12px; }
    .note { grid-template-columns: 58px minmax(0, 1fr) 12px; gap: 15px; }
    .site-footer { padding: 20px 0 26px; font-size: 11px; }
  }
  @media (max-width: 350px) {
    .container { width: calc(100% - 32px); }
    nav { gap: 10px; }
    nav a { font-size: 11px; }
    .header-actions { gap: 4px; }
    .contact-links { gap: 0 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; animation: none !important; }
  }
  @media print {
    :root, html[data-theme="dark"] { --background: #fff; --foreground: #111; --body: #333; --muted: #555; --accent: #17457a; --line: #ddd; }
    .site-header, .copy-email, .toast { display: none; }
    .container { width: 100%; }
    .hero { padding-top: 0; }
    .interest, .education-item, .note { break-inside: avoid; }
  }
</style>
